# Pétros Biokinetics security and performance configuration
# Apache Web Server Configuration (.htaccess)

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect HTTP to HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Use the plain domain (no www)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # One URL style: clean addresses without .html (/contact, /the-method).
    # /index.html goes to the home page
    RewriteCond %{THE_REQUEST} \s/index(\.html)?[\s?]
    RewriteRule ^index(\.html)?$ / [R=301,L]
    # Old /page.html links redirect to /page (only for real visitor requests, so no loops)
    RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
    RewriteCond %{REQUEST_URI} !^/(404|500)\.html$
    RewriteRule ^(.+)\.html$ /$1 [R=301,L]
    # A trailing slash is removed (/contact/ to /contact)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]
    # Serve /page from page.html behind the scenes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^.]+)$ /$1.html [L]

    # Files removed in the October 2026 refresh
    RewriteRule ^(loader|gradient-test)(\.html)?$ / [R=301,L]
    RewriteRule ^3d-render\.png$ /assets/img/anatomy-figure.webp [R=301,L]
    RewriteRule ^logo\.png$ /assets/img/logo-full-white.png [R=301,L]
    RewriteRule ^og-image\.jpg$ /assets/img/og-image.jpg [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Protect source and config files (the site itself is plain HTML/CSS/JS)
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(partials|src|tools|docs|node_modules)(/.*)?$
    RedirectMatch 404 ^/(package(-lock)?\.json|tailwind\.config\.js|CLAUDE\.md|README\.md)$
</IfModule>
<FilesMatch "(^\.|\.(env|sql|pem|key|bak)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Clickjacking protection - prevent site being embedded in frames
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Enable XSS protection in older browsers
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy - control how much referrer info is shared
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy - control browser features
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    
    # Content Security Policy: only the services this site uses
    # (Google Fonts, Google Analytics/Tag Manager after consent, Formspree forms, Google Maps embed, Cloudinary images)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://www.google.com https://www.googletagmanager.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"

    # Enforce Strict Transport Security (HTTPS only)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Enable GZIP compression for text-based files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Browser caching - set expiration times
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    
    # HTML (don't cache - keeps content fresh)
    ExpiresByType text/html "access plus 0 seconds"
    
    # Default
    ExpiresDefault "access plus 2 days"
</IfModule>

# Set proper cache control headers
<IfModule mod_headers.c>
    # Cache images for 1 year
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Cache CSS/JS for 1 month
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    
    # Cache fonts for 1 year
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Don't cache HTML files
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, public, must-revalidate"
    </FilesMatch>
</IfModule>

# UTF-8 character encoding
AddDefaultCharset UTF-8

# Gzip ETags for proper compression
<IfModule mod_headers.c>
    Header append Vary: Accept-Encoding
</IfModule>

# Performance: Disable ETags if you use multiple servers
# FileETag None
