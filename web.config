<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pétros Biokinetics: settings for the live server (Microsoft IIS).
  IIS ignores .htaccess; this file does the same jobs where IIS allows it.
  Pages use .html addresses (/contact.html), so no URL Rewrite add-on is needed.
  If the site shows a "500" error after uploading this file, the host has locked one of
  these settings: delete this file and tell your developer which error code you saw.
-->
<configuration>
  <system.webServer>
    <!-- File types older IIS versions don't know. "remove" first avoids a duplicate error. -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- House-style "page not found" page, with a real 404 status for Google -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Keep source and config files private (the site itself is plain HTML/CSS/JS) -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="partials" />
          <add segment="src" />
          <add segment="tools" />
          <add segment="docs" />
          <add segment="node_modules" />
          <add segment="package.json" />
          <add segment="package-lock.json" />
          <add segment="tailwind.config.js" />
          <add segment="CLAUDE.md" />
          <add segment=".htaccess" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
        <!-- Only the services this site uses: Google Fonts, Google Analytics/Tag Manager (after consent),
             Formspree forms, the Google Maps embed and Cloudinary images -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://www.google.com https://www.googletagmanager.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!--
    Old clean addresses (/contact, /faq …) that Google tried and got "not found" for:
    send them permanently to the real page (/contact.html). Uses IIS's built-in
    "HTTP Redirection" feature, not the URL Rewrite add-on. If that feature isn't
    installed on the server these addresses simply stay "not found"; nothing breaks.
    Don't add one for index.html: the home page is served from it, so it would loop.
  -->
  <location path="about">
    <system.webServer>
      <httpRedirect enabled="true" destination="/about.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="book-now">
    <system.webServer>
      <httpRedirect enabled="true" destination="/book-now.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="contact">
    <system.webServer>
      <httpRedirect enabled="true" destination="/contact.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="faq">
    <system.webServer>
      <httpRedirect enabled="true" destination="/faq.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="hydrotherapy">
    <system.webServer>
      <httpRedirect enabled="true" destination="/hydrotherapy.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="medical-aid">
    <system.webServer>
      <httpRedirect enabled="true" destination="/medical-aid.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="pricing">
    <system.webServer>
      <httpRedirect enabled="true" destination="/pricing.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="privacy-policy">
    <system.webServer>
      <httpRedirect enabled="true" destination="/privacy-policy.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="services">
    <system.webServer>
      <httpRedirect enabled="true" destination="/services.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="terms">
    <system.webServer>
      <httpRedirect enabled="true" destination="/terms.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="the-method">
    <system.webServer>
      <httpRedirect enabled="true" destination="/the-method.html" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
</configuration>
